{
  "description": "The Sutta of the day on the Practice hub. The page shows one entry a day, chosen in the visitor's browser from the entries in rotation, in this order, by the calendar date (practice/js/render-daily-sutta.js). Resting entries stay in the pool but are not shown. English only. origin: an older entry, or one sent from the Sati Sutta Curator (selection_id, and segment_ids where known).",
  "type": "object",
  "required": ["version", "entries"],
  "additionalProperties": false,
  "properties": {
    "version": {"const": 1},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "ref", "translator", "url", "text", "origin", "rotation", "sutta_id"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"},
          "title": {"type": "string", "minLength": 1},
          "ref": {"type": "string", "minLength": 1},
          "translator": {"type": "string", "minLength": 1},
          "url": {"type": "string", "pattern": "^https://suttacentral\\.net/"},
          "text": {"type": "string", "minLength": 1},
          "origin": {"enum": ["older", "curator"]},
          "rotation": {"enum": ["in_rotation", "resting"]},
          "sutta_id": {"type": "string", "pattern": "^[a-z]+[0-9][0-9.-]*$"},
          "selection_id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
          "segment_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[a-z]+[0-9][0-9.-]*:[0-9][0-9.-]*$"}}
        }
      }
    }
  }
}
